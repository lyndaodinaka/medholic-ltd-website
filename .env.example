# Keep this private inside Railway Variables. Do not display it on public pages.
ADMIN_EMAIL=your-private-manager-email@example.com
# Prefer ADMIN_PASSWORD_HASH in Railway. Generate with:
# npm run make-password-hash -- "your-password"
ADMIN_PASSWORD_HASH=pbkdf2:120000:replace_with_salt:replace_with_hash
# Optional fallback only for development:
# ADMIN_PASSWORD=your-private-manager-password
# Optional extra staff accounts for Railway:
# STAFF_ACCOUNTS_JSON=[{"username":"cashier@example.com","passwordHash":"pbkdf2:...","name":"Cashier One","role":"Cashier"}]
# Railway Postgres provides this automatically when attached:
# DATABASE_URL=postgresql://...
